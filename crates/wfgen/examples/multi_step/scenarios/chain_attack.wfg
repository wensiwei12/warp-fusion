use "../schemas/network.wfs"
use "../rules/chain_attack.wfl"

#[duration=60m]
scenario chain_attack_detect<seed=42> {
  background {
    stream conn_events gen 50/s
  }

  inject {
    // 完整攻击链：扫描(5次) + 登录失败(3次)
    hit<5625> for chain_attack conn_events {
      use(action="syn") x 5
            then use(action="login_fail", dport=22) x 3
    }

    // 仅扫描，无登录
    near_miss<5400> for chain_attack conn_events {
      use(action="syn") x 5
    }

    // 正常流量
    miss<108000> for chain_attack conn_events {
      use(action="syn") x 1
    }
  }
}
