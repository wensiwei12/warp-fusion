use "../schemas/dns.wfs"
use "../rules/dns_tunnel.wfl"

#[duration=10m]
scenario dns_tunnel_detect<seed=42> {
  traffic {
    stream dns_events gen 100/s
  }

  injection {
    hit<6000> for dns_tunnel dns_events {
      use(resp_size=1200) x 3
    }

    near_miss<3000> for dns_tunnel dns_events {
      use(resp_size=200) x 2
    }

    miss<36000> for dns_tunnel dns_events {
      use(resp_size=60) x 1
    }
  }

  expect {
    hit(dns_tunnel) >= 95%
    near_miss(dns_tunnel) <= 1%
    miss(dns_tunnel) <= 0.1%
  }
}
