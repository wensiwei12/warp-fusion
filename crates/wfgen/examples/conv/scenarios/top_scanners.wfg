use "../schemas/network.wfs"
use "../rules/top_scanners.wfl"

#[duration=2h]
scenario top_scanners_detect<seed=42> {
  background {
    stream conn_events gen 40/s
  }

  injection {
    // 高扫描者：生成5个 SYN 事件；端口分布由字段生成器负责
    hit<14400> for top_port_scanners conn_events {
      use(action="syn") x 5
    }

    // 中等扫描者：生成3个 SYN 事件
    near_miss<14400> for top_port_scanners conn_events {
      use(action="syn") x 3
    }

    // 正常流量：1个端口（低于阈值）
    miss<172800> for top_port_scanners conn_events {
      use(action="syn") x 1
    }
  }
}
