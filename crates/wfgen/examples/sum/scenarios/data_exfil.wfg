use "../schemas/network.wfs"
use "../rules/data_exfil.wfl"

#[duration=15m]
scenario data_exfil_detect<seed=42> {
  background {
    stream conn_events gen 100/s
  }

  injection {
    // 高流量外泄：4次30MB = 120MB > 100MB阈值，触发on event
    hit<5625> for data_exfil conn_events {
      use(action="send", bytes=30000000) x 4
    }

    // 中等流量：5次12MB = 60MB > 50MB关闭阈值，触发on close
    near_miss<3600> for data_exfil conn_events {
      use(action="send", bytes=12000000) x 5
    }

    // 正常低流量
    miss<49500> for data_exfil conn_events {
      use(action="send", bytes=1000) x 1
    }
  }
}
