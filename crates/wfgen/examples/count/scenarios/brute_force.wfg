use "../schemas/security.wfs"
use "../rules/brute_force.wfl"

#[duration=10m]
scenario brute_force_detect<seed=42> {
  background {
    // 原为 `gen 100/s` + `gen wave(base=80/s, ...)`：`wave` 语义未实现（VN28 拦下），当时按 base
    // 平坦化成第二行，于是同一个窗口出现两条 `stream auth_events`（现按 VN34 拒绝）。
    // 合并为一条：速率取两行之和（与原先生成量一致）。
    stream auth_events gen 180/s
  }

  inject {
    hit<4800> for brute_force_then_scan auth_events {
      use(action="failed") x 3
    }

    near_miss<2400> for brute_force_then_scan auth_events {
      use(action="failed") x 2
    }

    miss<28800> for brute_force_then_scan auth_events {
      use(action="success") x 1
    }
  }
}
