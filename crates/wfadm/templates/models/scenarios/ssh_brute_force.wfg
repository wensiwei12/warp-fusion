use "../schemas/auth.wfs"
use "../rules/02-initial_access/ssh_brute_force.wfl"

#[duration=10m]
scenario brute_force_detect<seed=42> {
  background {
    stream auth_events gen 50/s
  }
  injection {
    hit<500> for ssh_brute_force auth_events {
      use(result="failed", service="ssh") x 12
    }
    near_miss<1500> for ssh_brute_force auth_events {
      use(result="failed", service="ssh") x 2
    }
    miss<21000> for ssh_brute_force auth_events {
      use(result="success", service="ssh") x 1
    }
  }
}
