use "../schemas/network.wfs"
use "../rules/01-recon/port_scan.wfl"

#[duration=10m]
scenario port_scan_detect<seed=42> {
  traffic {
    stream conn_events gen 100/s
  }
  injection {
    hit<2000> for port_scan conn_events {
      use(action="syn") x 12
    }
    near_miss<6000> for port_scan conn_events {
      use(action="syn") x 2
    }
    miss<24000> for port_scan conn_events {
      use(action="established") x 1
    }
  }
  expect {
    hit(port_scan) >= 80%
    near_miss(port_scan) <= 5%
    miss(port_scan) <= 0.5%
  }
}
