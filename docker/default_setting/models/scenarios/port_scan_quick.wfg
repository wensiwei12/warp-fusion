use "../schemas/network.wfs"
use "../rules/01-recon/port_scan.wfl"

#[duration=1m]
scenario port_scan_quick<seed=42> {
  traffic {
    stream conn_events gen 500/s
  }
  injection {
    hit<750> for port_scan conn_events {
      use(action="syn") x 12
    }
    near_miss<1500> for port_scan conn_events {
      use(action="syn") x 2
    }
    miss<18000> for port_scan conn_events {
      use(action="established") x 1
    }
  }
  expect {
    hit(port_scan) >= 80%
    near_miss(port_scan) <= 5%
    miss(port_scan) <= 0.5%
  }
}
